# CleanC License Server 生产配置示例
# ------------------------------------------------------------
# 重要：本文件只能放“示例”，绝对不要把真实密码、Turnstile Secret、
# SESSION_SECRET、服务器签名私钥提交到 GitHub。
# 生产环境请到：Cloudflare Pages > Settings > Variables and Secrets 中填写。

# ========================
# 普通变量（不需要加密）
# ========================

# 软件名称。一般保持 CleanC 即可。
APP_NAME=CleanC

# Cloudflare Turnstile 的 Site Key。
# 这是公开值，可以放普通变量。
# 示例：0x4AAAAAAAxxxxxxxxxxxxxxxxxx
TURNSTILE_SITE_KEY=0x4AAAAAAA_这里替换成你的SiteKey

# 离线 Lease 时长，单位：小时。
# 生产建议保持 72；客户端平时本地验签，仅在 Lease 到期前 challenge + refresh。
LEASE_HOURS=72

# 永久 Bootstrap 地址。
# 必须填写 Cloudflare Pages 自带的稳定 pages.dev 地址，不要填临时预览地址。
# 示例：https://cleanc-license-server.pages.dev
BOOTSTRAP_BASE_URL=https://你的项目名.pages.dev

# ========================
# 加密 Secret（必须 Encrypt）
# ========================

# 管理后台登录密码。
# 示例仅供格式参考，请自行换成强密码，不要使用下面示例作为正式密码。
ADMIN_PASSWORD=CleanC_Admin_2026_请改成你自己的强密码

# 管理后台 Session/CSRF 的 HMAC 密钥。
# 必须随机生成，建议执行：openssl rand -base64 48
# 示例格式：x2Y...一长串随机字符...9Q=
SESSION_SECRET=这里粘贴openssl_rand生成的随机值

# Turnstile 的 Secret Key，必须选择 Encrypt。
# 示例：0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET=0x4AAAAAAA_这里替换成你的TurnstileSecret

# 服务器 P-256 PKCS#8 私钥，必须选择 Encrypt。
# 在 Cloudflare 输入框里直接粘贴完整 PEM（包含 BEGIN/END 两行和换行）。
# 下面只是占位示例，不能直接用于生产。
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n这里替换成你自己生成的PKCS8私钥\n-----END PRIVATE KEY-----"

# DEVICE_PROOF_SECRET：当前生产协议不再需要。
# 现在续期使用：challenge + 客户端设备私钥签名 + refresh，两次请求完成。
